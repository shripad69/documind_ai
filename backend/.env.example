# Optional: Google AI Studio key (only used for Gemini mind map generation; not needed for embeddings).
GOOGLE_API_KEY=your-google-api-key-here

# OpenRouter key used for chat answer generation.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Local BAAI/bge-m3 Embedding Configuration (defaults run on CPU)
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_CACHE_DIR=/app/models

# Optional: defaults are suitable for local Docker development.
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=90
# FRONTEND_ORIGIN=http://localhost:8080
# LOG_LEVEL=INFO
# LOG_COLOR=true
# COOKIE_SECURE=false
RETRIEVAL_MODE=hybrid_rrf

