# Google AI Studio key used only for PDF/DOCX embeddings.
GOOGLE_API_KEY=your-google-api-key-here

# OpenRouter key used for chat answer generation.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: defaults are suitable for local Docker development.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=90
# FRONTEND_ORIGIN=http://localhost:8080
# LOG_LEVEL=INFO
# LOG_COLOR=true
# COOKIE_SECURE=false
